{
  "name": "@aeondave/pi-theme-1337",
  "version": "0.5.1",
  "private": false,
  "type": "module",
  "description": "Thirteen vivid themes for Pi with a framed editor, compact tool views, theme-aware diffs, and configurable text spinners.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "pi-themes",
    "pi-coding-agent",
    "theme",
    "dark-theme",
    "terminal-theme",
    "statusline",
    "phosphor",
    "minimal",
    "tui"
  ],
  "license": "MIT",
  "author": {
    "name": "AeonDave"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AeonDave/pi-theme-1337.git"
  },
  "files": [
    "src",
    "themes",
    "docs",
    "assets/banner.png",
    "assets/palettes.gif",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:parity": "node --import tsx test/parity.ts",
    "preview": "node --import tsx test/preview.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/AeonDave/pi-theme-1337/v0.5.1/assets/banner.png",
    "extensions": [
      "./src/index.ts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
