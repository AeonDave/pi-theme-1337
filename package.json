{
  "name": "pi-1337",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Twelve vivid themes for Pi with a framed editor, compact tool views, theme-aware diffs, and configurable text spinners.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "theme",
    "phosphor",
    "minimal",
    "tui"
  ],
  "license": "MIT",
  "author": {
    "name": "AeonDave"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AeonDave/pi-theme-1337.git"
  },
  "files": [
    "src",
    "themes",
    "docs",
    "assets/banner.png",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:parity": "node --import tsx test/parity.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent@1.4.0": {
      "undici": "8.12.2"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
